# AgroNex AI Root Environment Variables Template
# Copy this file to .env (and backend/.env) and populate with your credentials.
# Note: NEVER commit real API keys or secrets to version control.

# 1. Gemma 4 / Gemini API (Multimodal Agricultural AI Copilot)
# Read from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_or_gemma_api_key_here
GOOGLE_API_KEY=
# Optional Gemma model override: gemma-4, gemma-3-27b-it, gemini-2.5-flash, gemini-1.5-flash
GEMMA_MODEL=gemini-2.5-flash

# 2. Sarvam AI (Optional voice STT & TTS for Tamil/English conversational audio)
SARVAM_API_KEY=your_sarvam_api_key_here

# 3. Supabase Cloud Database & Storage (Optional: defaults to local SQLite agronex.db if omitted)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key_here

# 4. Networking & CORS Deployment
FRONTEND_URL=http://localhost:5173
ALLOW_ALL_ORIGINS=true

# 5. Open-Meteo Weather Service (Free open-access API - no API key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# AgroNex AI Backend Environment Variables Template
# Copy to backend/.env and populate with your own credentials.
# NEVER commit real credentials to version control.

# 1. Gemma 4 / Gemini API (Multimodal AI Assistant & Symptom Explainer)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_or_gemma_api_key_here
GOOGLE_API_KEY=
# Configurable model (defaults to gemini-2.5-flash / gemma-3-27b-it / gemma-4)
GEMMA_MODEL=gemini-2.5-flash

# 2. Sarvam AI (Optional voice STT & TTS for Tamil / Indian English audio)
SARVAM_API_KEY=your_sarvam_api_key_here

# 3. Supabase Credentials (Optional: automatic zero-setup fallback to local SQLite)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key_here

# 4. Web CORS & Network settings
FRONTEND_URL=http://localhost:5173
ALLOW_ALL_ORIGINS=true

# 5. Open-Meteo Weather Service (No API key required - free open weather data)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
